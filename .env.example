# Copy this file to .env and fill in your values. .env is git-ignored.

# --- Required -------------------------------------------------------------
# Model used for the conversation.
MODEL_CHAT_NAME=your-chat-model

# --- Provider (optional) --------------------------------------------------
# API key. If empty, the OpenAI SDK falls back to the OPENAI_API_KEY variable.
API_KEY=your-api-key
# Base URL of any OpenAI-compatible API. Leave empty for the default OpenAI endpoint.
PV_BASE_URL=https://your-provider.example/v1

# --- Behaviour (optional) -------------------------------------------------
# Model used to summarize long conversations (defaults to MODEL_CHAT_NAME).
MODEL_SUMMARIZE_NAME=
# Summarize once the conversation context reaches this many tokens (default 1000).
MT_FOR_START_SUMMARIZE=1000
# Where chats are stored (default sqlite:///database.db).
DATABASE_URL=sqlite:///database.db
# Ask the provider for token usage while streaming. Set to false if your
# provider rejects the "stream_options" parameter; tokens are then estimated.
INCLUDE_STREAM_USAGE=true
